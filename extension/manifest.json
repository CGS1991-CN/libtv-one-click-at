{
  "manifest_version": 3,
  "name": "LibTV 一键绑定 @",
  "version": "1.0.4",
  "description": "识别 @image1、@图片 1、@图1，严格按编号绑定当前参考图片。只编辑提示词，不开始生成。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.liblib.tv/canvas*", "https://liblib.tv/canvas*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
